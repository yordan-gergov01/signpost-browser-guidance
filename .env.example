# Copy to .env and fill in. .env is gitignored and must never be committed.

# Server-side only. The extension and the SDK never see this key; they call our
# own /guide endpoint and the server calls OpenAI.
OPENAI_API_KEY=sk-...

# Fastify listen config for apps/server
PORT=8787
HOST=127.0.0.1

# Comma-separated CORS allow-list. No wildcard.
CORS_ORIGINS=http://localhost:5173

# Per-session guardrails, enforced server-side. The client is not trusted.
MAX_STEPS_PER_SESSION=8
MAX_LLM_CALLS_PER_SESSION=12
MAX_INPUT_TOKENS_PER_SESSION=60000
